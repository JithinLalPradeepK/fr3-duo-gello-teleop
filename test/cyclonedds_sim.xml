<?xml version="1.0" encoding="UTF-8"?>
<!-- SIM TEST ONLY (ROS_LOCALHOST_ONLY=1): lo has no multicast, so Cyclone uses unicast participant
     indices; the default max is too small for two arm stacks + gates + driver. -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
      <Peers><Peer address="localhost"/></Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
